# LLM Provider Configuration
# The backend uses the OpenAI client SDK and works with any OpenAI-compatible API.
# If left empty or unset, the system runs with offline heuristic fallback rules.

# Option 1: Groq (Recommended - Fast & Free tier)
# https://console.groq.com/keys
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Option 2: OpenAI
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Option 3: Google Gemini (via OpenAI compatibility endpoint)
# https://aistudio.google.com/app/apikey
# OPENAI_API_KEY=your_gemini_api_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-1.5-flash

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
